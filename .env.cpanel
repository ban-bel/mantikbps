###########################################################
# MantikBps - Konfigurasi .env untuk cPanel (PRODUCTION)
#
# Aplikasi di-deploy pada subpath /mantikbps di:
#   https://digistat.web.bps.go.id/mantikbps
#
# Langkah deploy di server cPanel:
#   1. Salin file ini menjadi ".env" di root aplikasi.
#   2. Sesuaikan kredensial DB MySQL (menu "MySQL Databases").
#   3. Jalankan:
#        php artisan config:clear
#        php artisan config:cache
#        php artisan route:clear
#        php artisan view:clear
#        php artisan migrate --force
#        php artisan storage:link   (jika belum)
#   4. Hard refresh browser (Ctrl+F5).
###########################################################

APP_NAME="Manajemen Publikasi Statistik BPS"
APP_ENV=production
APP_KEY=base64:/uR0h3vM90vk2OTw9CuJI9YMhC+6C80mfKTwKWpP9kc=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://digistat.web.bps.go.id/mantikbps

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Aplikasi berjalan pada subpath /mantikbps -> atur base aset & paksa HTTPS.
# FORCE_HTTPS dibaca AppServiceProvider (URL::forceScheme('https')) untuk
# memperbaiki CSP form-action & mixed-content di belakang proxy SSL cPanel.
VITE_BASE=/mantikbps/
ASSET_URL=https://digistat.web.bps.go.id/mantikbps
FORCE_HTTPS=true

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Logging (produksi: cukup level error)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==========================================================
# DATABASE - MySQL cPanel (WAJIB sesuaikan dengan akun Anda)
# ==========================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=digistat_mantikbps
DB_USERNAME=digistat_bps1900
DB_PASSWORD=bps19jaya

# ==========================================================
# SESSION & CACHE - gunakan database (cocok untuk shared hosting cPanel)
# SESSION_SECURE_COOKIE=true wajib karena situs diakses via HTTPS.
# ==========================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_TABLE=sessions

# Tanpa queue worker (cPanel biasa): notifikasi dikirim setelah respons HTTP.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=
DB_CACHE_TABLE=cache

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================
# MAIL - dipakai untuk kirim kode reset password (AuthController).
# Isi kredensial SMTP resmi. Default "log" agar email hanya tercatat
# di storage/logs bila SMTP belum dikonfigurasi.
# ==========================================================
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@bps.go.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
